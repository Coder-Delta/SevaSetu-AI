# App Configuration
APP_NAME="SevaSetu AI"
APP_ENV=development
SECRET_KEY=change-me-before-production
JWT_SECRET_KEY=change-me-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
DATABASE_URL=sqlite:///./data/relational_db/sevasetu.db
# ASSUMPTION: SQLite is the default local development database so the project
# can run without Docker. Switch to PostgreSQL later if you want the container setup.
# DATABASE_URL=postgresql://sevasetu:sevasetu_dev@localhost:5432/sevasetu
POSTGRES_USER=sevasetu
POSTGRES_PASSWORD=sevasetu_dev
POSTGRES_DB=sevasetu

# ChromaDB Vector DB
CHROMA_PERSIST_DIRECTORY=./data/vector_db/chroma_store
CHROMA_COLLECTION_NAME=scheme_embeddings

# Groq LLM API
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-specdec

# Embeddings (HuggingFace local embeddings - free, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Phase 1 dataset
SCHEMES_DATASET_PATH=./data/fixtures/schemes_dataset.csv
MOCK_DATA_MODE=true

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=citizen-documents
MINIO_SECURE=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
